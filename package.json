{
  "name": "mirror",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "vercel-build": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && DATABASE_URL=file:./prisma/dev.db prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "smoke:deploy": "bash .codex/skills/reflecta-deploy-check/scripts/smoke.sh https://reflecta-delta.vercel.app",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:push:snapshot": "DATABASE_URL=file:./prisma/dev.db prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:backfill:node-context": "tsx scripts/backfill-node-context.ts",
    "db:reset": "prisma db push --force-reset && tsx scripts/seed.ts",
    "db:reset-empty": "prisma db push --force-reset --accept-data-loss",
    "import:conversations": "tsx scripts/import.ts",
    "prompts:seed": "tsx scripts/seed-prompts.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.1",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^0.456.0",
    "next": "14.2.18",
    "next-auth": "^5.0.0-beta.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^7.7.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
