{
  "name": "mirror",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "smoke:deploy": "bash .codex/skills/reflecta-deploy-check/scripts/smoke.sh https://reflecta-delta.vercel.app",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:snapshot:dev": "tsx -r dotenv/config scripts/snapshot-dev-data.ts",
    "db:load:dev-snapshot": "tsx -r dotenv/config scripts/load-dev-snapshot.ts",
    "db:clear:app-data": "tsx -r dotenv/config scripts/clear-dev-data.ts",
    "db:backfill:node-context": "tsx scripts/backfill-node-context.ts",
    "db:reset": "prisma db push --force-reset && tsx scripts/seed.ts",
    "db:reset-empty": "prisma db push --force-reset --accept-data-loss",
    "import:conversations": "tsx scripts/import.ts",
    "prompts:seed": "tsx scripts/seed-prompts.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xyflow/react": "^12.10.2",
    "dotenv": "^17.4.1",
    "lucide-react": "^0.456.0",
    "next": "14.2.18",
    "next-auth": "^5.0.0-beta.22",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
