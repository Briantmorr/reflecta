generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth / Auth.js) ───────────────────────────────────
// These models are only used when AUTH_ENABLED=true.
// When the flag is off the tables stay empty and conversations are ownerless.
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  graphNodes    GraphNode[]
  graphEdges    GraphEdge[]
  editedNodeContextVersions NodeContextVersion[] @relation("EditedNodeContextVersions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Chat sessions ────────────────────────────────────────────────
model Conversation {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sourceRef   String?   @unique
  sourceType  String?
  sourceName  String?
  importedAt  DateTime?

  // Owner is nullable so local-dev (AUTH_ENABLED=false) can create
  // conversations without a user. When auth is on we always set it.
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  Message[]
  nodeTags  ConversationNode[]

  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String        // 'user' | 'assistant' | 'system'
  content        String
  createdAt      DateTime      @default(now())

  // Which graph nodes this message contributed to / referenced
  nodeRefs       MessageNode[]

  @@index([conversationId])
}

// ─── Psyche graph ────────────────────────────────────────────────
// A Node IS a tag. Future messages are auto-tagged against existing nodes.
model GraphNode {
  id          String        @id @default(cuid())
  label       String        // normalized label acts as the tag key
  type        String        // 'user' | 'person' | 'role' | 'domain' | 'emotion'
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every time a node is referenced its weight increases
  mentionCount Int          @default(1)

  // Distilled insights across all conversations tagged to this node.
  // Populated on demand via the "Node insights" button.
  insightSummary     String?
  insightBullets     String?    // JSON-encoded string[] of short observations
  insightGeneratedAt DateTime?

  // Factual distillation ("memory") of the user grounded in this node's conversations.
  // Editable by the user. For the User node this acts as the global user profile.
  contextText        String?
  contextUpdatedAt   DateTime?
  contextSource      String?

  fromEdges   GraphEdge[]   @relation("FromNode")
  toEdges     GraphEdge[]   @relation("ToNode")
  messageRefs MessageNode[]
  conversationRefs ConversationNode[]
  contextVersions NodeContextVersion[]

  @@unique([userId, label])
  @@index([userId])
}

model NodeContextVersion {
  id        String    @id @default(cuid())
  nodeId     String
  node       GraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  content   String
  source    String    // 'generated' | 'user_edit'
  createdAt DateTime  @default(now())

  editedByUserId String?
  editedByUser   User? @relation("EditedNodeContextVersions", fields: [editedByUserId], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt])
  @@index([editedByUserId])
}

model PromptConfig {
  key             String          @id
  activeVersionId String?         @unique
  activeVersion   PromptVersion?  @relation("ActivePromptVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  updatedAt       DateTime?
  updatedBy       String?
  versions        PromptVersion[] @relation("PromptConfigVersions")
}

model PromptVersion {
  id        String        @id @default(cuid())
  key       String
  config    PromptConfig  @relation("PromptConfigVersions", fields: [key], references: [key], onDelete: Cascade)
  content   String
  label     String?
  createdAt DateTime      @default(now())
  createdBy String?

  activeFor PromptConfig? @relation("ActivePromptVersion")

  @@index([key, createdAt])
}

model GraphEdge {
  id           String    @id @default(cuid())
  fromId       String
  toId         String
  relationship String
  createdAt    DateTime  @default(now())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromNode     GraphNode @relation("FromNode", fields: [fromId], references: [id], onDelete: Cascade)
  toNode       GraphNode @relation("ToNode",   fields: [toId],   references: [id], onDelete: Cascade)

  @@unique([userId, fromId, toId, relationship])
  @@index([fromId])
  @@index([toId])
  @@index([userId])
}

// Join table: a message is "tagged" with the nodes it references.
// Lets us later build a "timeline" for any node and do cross-conversation retrieval.
model MessageNode {
  messageId String
  nodeId    String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  node      GraphNode @relation(fields: [nodeId],    references: [id], onDelete: Cascade)

  @@id([messageId, nodeId])
  @@index([nodeId])
}

// Join table: a conversation is tagged with the nodes that best describe it.
// These tags drive the visible graph and can be manually removed by the user.
model ConversationNode {
  conversationId String
  nodeId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  node           GraphNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([conversationId, nodeId])
  @@index([nodeId])
}
