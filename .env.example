# ─── Database ─────────────────────────────────────────────
# SQLite (default — zero setup). Local dev uses repo-root dev.db.
# The committed Vercel/demo snapshot lives separately at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# ─── Auth (NextAuth / Auth.js v5) ─────────────────────────
# Feature flag — auth is OFF by default so local dev "just works".
# Flip to "true" (and fill in the vars below) to gate the app
# behind Google sign-in.
AUTH_ENABLED="false"

# Required when AUTH_ENABLED=true. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Required when AUTH_ENABLED=true. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
#   - Authorized JS origin:   http://localhost:3000
#   - Authorized redirect:    http://localhost:3000/api/auth/callback/google
# For Vercel deploys, also add your Vercel URL as an authorized origin
# and https://<your-vercel-url>/api/auth/callback/google as a redirect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Auth.js auto-detects this on Vercel, but if you self-host
# or hit callback-URL issues set it to your public base URL.
# AUTH_URL="http://localhost:3000"

# ─── Dev Prompt Editor (Optional) ─────────────────────────
# Enables a temporary profile/settings prompt editor for non-technical prompt iteration.
# Prompt versions persist in Firestore and local prompts/*.json remain the fallback.
# Uses Firebase Admin server credentials, not the Firebase browser SDK config.
ENABLE_PROMPT_EDITOR="false"
ENABLE_REMOTE_PROMPTS="false"
PROMPT_EDITOR_SECRET="dinotopia"
# From Firebase service account JSON: project_id, client_email, private_key.
FIREBASE_PROJECT_ID="mirror-57d7a"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@mirror-57d7a.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="7afe1f0737d68d9cfde3a4635f2647d0e07dcdf5"
