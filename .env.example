# ─── Database ─────────────────────────────────────────────
# SQLite (default — zero setup). Local dev uses repo-root dev.db.
# The committed Vercel/demo snapshot lives separately at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# ─── Auth (NextAuth / Auth.js v5) ─────────────────────────
# Feature flag — auth is OFF by default so local dev "just works".
# Flip to "true" (and fill in the vars below) to gate the app
# behind Google sign-in.
AUTH_ENABLED="false"

# Required when AUTH_ENABLED=true. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Required when AUTH_ENABLED=true. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
#   - Authorized JS origin:   http://localhost:3000
#   - Authorized redirect:    http://localhost:3000/api/auth/callback/google
# For Vercel deploys, also add your Vercel URL as an authorized origin
# and https://<your-vercel-url>/api/auth/callback/google as a redirect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Auth.js auto-detects this on Vercel, but if you self-host
# or hit callback-URL issues set it to your public base URL.
# AUTH_URL="http://localhost:3000"
